{
  "name": "dsh-better-sidebar-left",
  "version": "0.1.0",
  "description": "Session management for DeepSeek Harness in one install: delete a session with a risk-checked confirmation, move one across workspaces (menu and drag), rename one by double-clicking its title, show per-workspace session counts, and declutter both the sidebar and the conversation's collapsed turns. Self-contained: the plugin list shows this one row, and the five components are vendored inside it - installing this plugin installs nothing else.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./delete": "./src/shell.js",
    "./relocate": "./src/shell.js",
    "./rename": "./src/shell.js",
    "./counts": "./src/shell.js",
    "./declutter": "./src/shell.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/shell.js",
    "src/components.js",
    "src/client.js",
    "src/vendor/host",
    "src/vendor/versions.json",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session",
    "sidebar",
    "delete-session",
    "relocate",
    "rename",
    "counts",
    "declutter"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDMUC/dsh-better-sidebar-left.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor": "node tools/vendor.mjs",
    "build": "node tools/vendor.mjs && node tools/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run verify:manifest && npm run build && npm test",
    "bump": "node tools/bump.mjs",
    "verify:vendor": "node tools/vendor.mjs --check",
    "verify:build": "node tools/build.mjs --check",
    "verify:manifest": "node tools/verify-manifest.mjs",
    "link:local": "node tools/link-local.mjs",
    "push:github": "node tools/push-github.mjs"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "vendorSources": {
      "dsh-delete-session": {
        "repo": "https://github.com/DDDMUC/dsh-delete-session",
        "ref": "main",
        "commit": "ace70523d299b57ab4d86563f99b728ffdc0150f",
        "version": "0.5.0"
      },
      "dsh-session-relocate": {
        "repo": "https://github.com/DDDMUC/dsh-session-relocate",
        "ref": "main",
        "commit": "b2695f40c4c442c4aa5a4e57294a0f7a6d5c263f",
        "version": "0.3.1"
      },
      "dsh-session-rename-dblclick": {
        "repo": "https://github.com/DDDMUC/dsh-session-rename-dblclick",
        "ref": "main",
        "commit": "e23f2a5eb5a037604d77115985ef19a131fab4d6",
        "version": "0.1.3"
      },
      "dsh-session-counts": {
        "repo": "https://github.com/DDDMUC/dsh-session-counts",
        "ref": "main",
        "commit": "51971fd0c7093fc4921fc2f70a602a9dd7e21f30",
        "version": "0.0.3"
      },
      "dsh-declutter": {
        "repo": "https://github.com/DDDMUC/dsh-declutter",
        "ref": "main",
        "commit": "0ae7873dabdc39ddd26ff7a9ea58f04841c8b003",
        "version": "0.2.0"
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-trajectory",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    },
    "vendorSourcesNote": "Every component source is a local git checkout of its GitHub repository at this exact commit (dsh-better-sidebar-left-src/components/<package>). A commit is what makes a build reproducible - a dist-tag is not - so all five are taken the same way, whether or not the same version is also on the npm registry."
  }
}
